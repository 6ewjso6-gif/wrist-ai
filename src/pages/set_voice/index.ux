<template>
  <div class="page">
    <div class="bar">
      <text class="nav" @click="back">返回</text>
      <text class="title">语音</text>
      <text class="nav-green" @click="save">保存</text>
    </div>

    <scroll class="body" scroll-y="true">
      <text class="sec">语音识别</text>
      <text class="lb">接口地址</text>
      <input class="inp" type="text" value="{{cfg.asrUrl}}" @change="onAsrUrl" />
      <text class="lb">密钥</text>
      <input class="inp" type="text" value="{{cfg.asrKey}}" placeholder="sk-..." @change="onAsrKey" />
      <text class="sec">朗读</text>
      <text class="lb">URL 模板（{text} 会被替换）</text>
      <input class="inp" type="text" value="{{cfg.ttsUrl}}" @change="onTtsUrl" />
      <div class="presets">
        <text class="pill" @click="youdao">有道 免费</text>
        <text class="pill-green" @click="test">试听</text>
      </div>
      <text class="st">{{status}}</text>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { loadConfig, saveConfig } from '../../common/config.js'
import { speakText } from '../../common/api.js'

export default {
  private: { cfg: { asrUrl: '', asrKey: '', ttsUrl: '' }, status: '' },
  onInit() { loadConfig().then((c) => { this.cfg = c }) },
  onAsrUrl(e) { this.cfg.asrUrl = e.value },
  onAsrKey(e) { this.cfg.asrKey = e.value },
  onTtsUrl(e) { this.cfg.ttsUrl = e.value },
  youdao() {
    this.cfg.ttsUrl = 'https://dict.youdao.com/dictvoice?type=2&audio={text}'
    this.status = '已填有道（免费）'
  },
  test() {
    this.status = '合成中…'
    speakText(this.cfg, '你好我是腕上AI')
      .then(() => { this.status = '正在播放' })
      .catch((e) => { this.status = '失败：' + String(e).slice(0, 40) })
  },
  save() {
    saveConfig(this.cfg).then((ok) => {
      this.status = ok ? '已保存' : '保存失败'
      prompt.showToast({ message: ok ? '已保存' : '失败', duration: 1000 })
      if (ok) setTimeout(() => router.back(), 500)
    })
  },
  back() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; background-color: #000000; }
.bar { flex-direction: row; align-items: center; justify-content: space-between;
       height: 56px; margin-top: 56px; padding-left: 88px; padding-right: 88px; }
.title { color: #62d0ff; font-size: 26px; font-weight: bold; }
.nav { color: #c9d6e2; font-size: 21px; width: 76px; }
.nav-green { color: #ffffff; background-color: #238636; font-size: 19px;
             width: 80px; height: 44px; line-height: 44px; text-align: center; border-radius: 22px; }
.body { height: 280px; padding-left: 88px; padding-right: 88px; }
.lb { color: #8a94a0; font-size: 18px; margin-top: 8px; margin-bottom: 3px; }
.inp { height: 48px; background-color: #1c2128; border-radius: 24px;
       color: #e6edf3; font-size: 18px; padding-left: 16px; padding-right: 16px; }
.st { color: #d29922; font-size: 17px; margin-top: 8px; text-align: center; }
.sec { color: #62d0ff; font-size: 20px; font-weight: bold; margin-top: 10px; }
.presets { flex-direction: row; justify-content: center; margin-top: 10px; }
.pill { background-color: #1f6feb; color: #ffffff; font-size: 17px;
        height: 44px; line-height: 44px; text-align: center; border-radius: 22px;
        width: 118px; margin: 0 4px; }
.pill-green { background-color: #238636; color: #ffffff; font-size: 17px;
              height: 44px; line-height: 44px; text-align: center; border-radius: 22px;
              width: 88px; margin: 0 4px; }
</style>
