<template>
  <div class="page">
    <div class="bar">
      <text class="bar-btn" @click="back">←</text>
      <text class="bar-title">设置</text>
      <text class="bar-btn" @click="save">保存</text>
    </div>

    <scroll class="body" scroll-y="true">

      <!-- ===== 对话 ===== -->
      <text class="sec">对话模型</text>
      <text class="label">API 地址</text>
      <input class="inp" type="text" value="{{cfg.apiUrl}}" placeholder="https://.../chat/completions" @change="onUrl" />
      <text class="label">API 密钥</text>
      <input class="inp" type="text" value="{{cfg.apiKey}}" placeholder="sk-..." @change="onKey" />
      <text class="label">模型名</text>
      <input class="inp" type="text" value="{{cfg.model}}" placeholder="deepseek-chat" @change="onModel" />
      <div class="row">
        <text class="pill" @click="preset('deepseek')">DeepSeek</text>
        <text class="pill" @click="preset('qwen')">通义</text>
        <text class="pill" @click="preset('kimi')">Kimi</text>
      </div>

      <!-- ===== 提示词 ===== -->
      <text class="sec">提示词风格</text>
      <div class="row">
        <text class="pill" @click="cyclePrompt">{{promptName}} ▸</text>
      </div>
      <text class="label">自定义提示词（填写后覆盖上面的风格）</text>
      <input class="inp tall" type="text" value="{{cfg.customPrompt}}" placeholder="留空则用风格预设" @change="onCustom" />

      <!-- ===== 语音识别 ===== -->
      <text class="sec">语音识别（录音转文字）</text>
      <text class="label">接口地址</text>
      <input class="inp" type="text" value="{{cfg.asrUrl}}" placeholder="https://api.openai.com/v1/audio/transcriptions" @change="onAsrUrl" />
      <text class="label">密钥</text>
      <input class="inp" type="text" value="{{cfg.asrKey}}" placeholder="sk-..." @change="onAsrKey" />
      <text class="label">模型</text>
      <input class="inp" type="text" value="{{cfg.asrModel}}" placeholder="whisper-1" @change="onAsrModel" />

      <!-- ===== 朗读 ===== -->
      <text class="sec">朗读（文字转语音）</text>
      <text class="label">TTS 接口地址</text>
      <input class="inp" type="text" value="{{cfg.ttsUrl}}" placeholder="https://api.openai.com/v1/audio/speech" @change="onTtsUrl" />
      <text class="label">密钥</text>
      <input class="inp" type="text" value="{{cfg.ttsKey}}" placeholder="sk-..." @change="onTtsKey" />
      <text class="label">模型 / 音色</text>
      <input class="inp" type="text" value="{{cfg.ttsModel}}" placeholder="tts-1" @change="onTtsModel" />
      <input class="inp" type="text" value="{{cfg.ttsVoice}}" placeholder="alloy" @change="onTtsVoice" />

      <!-- ===== 快捷提问 ===== -->
      <text class="sec">快捷提问（空聊天时显示）</text>
      <input class="inp" type="text" value="{{cfg.quickAsks[0]}}" placeholder="问题 1" @change="onQ1" />
      <input class="inp" type="text" value="{{cfg.quickAsks[1]}}" placeholder="问题 2" @change="onQ2" />
      <input class="inp" type="text" value="{{cfg.quickAsks[2]}}" placeholder="问题 3" @change="onQ3" />
      <input class="inp" type="text" value="{{cfg.quickAsks[3]}}" placeholder="问题 4" @change="onQ4" />

      <text class="hint">{{status}}</text>
      <text class="hint">S5 46mm eSIM 请确认已开通蜂窝数据或连上 WiFi</text>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { loadConfig, saveConfig, getPromptSets } from '../../common/config.js'

const PRESETS = {
  deepseek: { apiUrl: 'https://api.deepseek.com/chat/completions', model: 'deepseek-chat' },
  qwen: { apiUrl: 'https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions', model: 'qwen-plus' },
  kimi: { apiUrl: 'https://api.moonshot.cn/v1/chat/completions', model: 'moonshot-v1-8k' }
}

export default {
  private: {
    cfg: { apiUrl: '', apiKey: '', model: '', customPrompt: '', promptSetId: 'short',
           asrUrl: '', asrKey: '', asrModel: '', ttsUrl: '', ttsKey: '', ttsModel: '', ttsVoice: '',
           quickAsks: ['', '', '', ''] },
    promptName: '极简',
    status: ''
  },

  onInit() {
    loadConfig().then((c) => { this.cfg = c; this.syncName() })
  },

  syncName() {
    const sets = getPromptSets()
    const s = sets.filter((x) => x.id === this.cfg.promptSetId)[0]
    this.promptName = this.cfg.customPrompt ? '自定义' : (s ? s.name : '极简')
  },

  onUrl(e) { this.cfg.apiUrl = e.value },
  onKey(e) { this.cfg.apiKey = e.value },
  onModel(e) { this.cfg.model = e.value },
  onCustom(e) { this.cfg.customPrompt = e.value; this.syncName() },
  onAsrUrl(e) { this.cfg.asrUrl = e.value },
  onAsrKey(e) { this.cfg.asrKey = e.value },
  onAsrModel(e) { this.cfg.asrModel = e.value },
  onTtsUrl(e) { this.cfg.ttsUrl = e.value },
  onTtsKey(e) { this.cfg.ttsKey = e.value },
  onTtsModel(e) { this.cfg.ttsModel = e.value },
  onTtsVoice(e) { this.cfg.ttsVoice = e.value },
  onQ1(e) { this.cfg.quickAsks[0] = e.value },
  onQ2(e) { this.cfg.quickAsks[1] = e.value },
  onQ3(e) { this.cfg.quickAsks[2] = e.value },
  onQ4(e) { this.cfg.quickAsks[3] = e.value },

  preset(name) {
    const p = PRESETS[name]
    if (!p) return
    this.cfg.apiUrl = p.apiUrl
    this.cfg.model = p.model
    this.status = '已填入 ' + name
  },

  cyclePrompt() {
    const sets = getPromptSets()
    let i = 0
    for (let k = 0; k < sets.length; k++) if (sets[k].id === this.cfg.promptSetId) i = k
    i = (i + 1) % sets.length
    this.cfg.promptSetId = sets[i].id
    this.syncName()
    this.status = '风格：' + this.promptName
  },

  save() {
    saveConfig(this.cfg).then((ok) => {
      this.status = ok ? '✅ 已保存' : '❌ 保存失败'
      prompt.showToast({ message: ok ? '已保存' : '保存失败', duration: 1200 })
      if (ok) setTimeout(() => router.back(), 600)
    })
  },

  back() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; background-color: #000000; }
.bar {
  flex-direction: row; justify-content: space-between; align-items: center;
  height: 44px; padding-left: 64px; padding-right: 64px;
}
.bar-title { color: #62d0ff; font-size: 22px; font-weight: bold; }
.bar-btn { color: #62d0ff; font-size: 22px; }

.body { flex: 1; flex-direction: column; padding: 4px 40px 20px 40px; }

.sec {
  color: #62d0ff; font-size: 19px; font-weight: bold;
  margin-top: 16px; margin-bottom: 6px;
}
.label { color: #8a94a0; font-size: 17px; margin-top: 8px; margin-bottom: 3px; }
.inp {
  height: 40px; background-color: #1c2128; border-radius: 20px;
  color: #e6edf3; font-size: 17px; padding-left: 12px; padding-right: 12px;
  margin-bottom: 4px;
}
.tall { height: 62px; border-radius: 14px; }

.row { flex-direction: row; justify-content: center; margin-top: 8px; }
.pill {
  background-color: #1f6feb; color: #ffffff;
  font-size: 17px; padding: 6px 14px; border-radius: 14px; margin: 0 6px;
}
.hint { color: #d29922; font-size: 17px; margin-top: 12px; }
</style>
