<template>
  <div class="page">
    <div class="bar">
      <text class="nav" @click="back">返回</text>
      <text class="title">设置</text>
      <text class="gap"></text>
    </div>

    <div class="menu">
      <div class="row" @click="go('/pages/set_chat')">
        <text class="rt">对话模型</text>
        <text class="rs">{{chatState}}</text>
      </div>
      <div class="row" @click="go('/pages/set_voice')">
        <text class="rt">语音</text>
        <text class="rs">{{voiceState}}</text>
      </div>
      <div class="row" @click="go('/pages/set_quick')">
        <text class="rt">快捷提问</text>
        <text class="rs">{{quickCount}} 条</text>
      </div>
      <div class="row" @click="go('/pages/diag')">
        <text class="rt">自检</text>
        <text class="rs">各项能力检测</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { loadConfig } from '../../common/config.js'

export default {
  private: { chatState: '', voiceState: '', quickCount: 0 },

  onShow() {
    loadConfig().then((c) => {
      this.chatState = c.apiKey ? (c.model || '已配置') : '未配置'
      this.voiceState = (c.asrKey ? '识别√' : '识别×') + ' ' + (c.ttsUrl ? '朗读√' : '朗读×')
      this.quickCount = (c.quickAsks || []).length
    })
  },

  go(uri) { router.push({ uri: uri }) },
  back() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; background-color: #000000; }
.bar { flex-direction: row; align-items: center; justify-content: space-between;
       height: 56px; margin-top: 56px; padding-left: 88px; padding-right: 88px; }
.title { color: #62d0ff; font-size: 26px; font-weight: bold; }
.nav { color: #c9d6e2; font-size: 21px; width: 76px; }
.gap { width: 76px; }

.menu { height: 280px; padding-left: 88px; padding-right: 88px; padding-top: 4px; }
.row { flex-direction: column; justify-content: center;
       height: 64px; background-color: #1c2128; border-radius: 18px;
       margin-bottom: 9px; padding-left: 20px; }
.rt { color: #e6edf3; font-size: 22px; }
.rs { color: #8a94a0; font-size: 16px; margin-top: 1px; }
</style>
