<template>
  <div class="page">
    <div class="bar">
      <text class="nav" @click="back">返回</text>
      <text class="title">自检</text>
      <text class="nav-green" @click="runAll">重测</text>
    </div>

    <scroll class="body" scroll-y="true">
      <div class="item" for="{{checks}}">
        <div class="{{ $item.ok ? 'dot-ok' : 'dot-bad' }}"></div>
        <div class="ib">
          <text class="in">{{ $item.name }}</text>
          <text class="im">{{ $item.msg }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'

function mk(n) { return { name: n, ok: false, msg: '待检测' } }

export default {
  private: { checks: [] },

  onInit() {
    this.checks = [mk('录音'), mk('上传'), mk('播放'), mk('下载'),
                   mk('振动'), mk('存储'), mk('网络'), mk('对话'), mk('朗读')]
    this.runAll()
  },

  set(i, ok, msg) {
    const a = this.checks.slice()
    a[i] = { name: a[i].name, ok: ok, msg: msg }
    this.checks = a
  },

  runAll() {
    const mods = [['@system.record', 0], ['@system.uploadtask', 1], ['@system.audio', 2],
                  ['@system.request', 3], ['@system.vibrator', 4], ['@system.storage', 5]]
    for (let k = 0; k < mods.length; k++) {
      try { this.set(mods[k][1], !!require(mods[k][0]), '可用') }
      catch (e) { this.set(mods[k][1], false, '不可用') }
    }
    try {
      require('@system.network').getType({
        success: (r) => { const t = (r && r.type) ? r.type : '?'; this.set(6, t !== 'none', t) },
        fail: () => this.set(6, false, '查询失败')
      })
    } catch (e) { this.set(6, false, '不可用') }

    try {
      require('@system.storage').get({
        key: 'aiConfig',
        success: (r) => {
          let c = null
          try { c = r && r.data ? JSON.parse(r.data) : null } catch (e) {}
          this.checkChat(c)
          this.checkTts(c)
        },
        fail: () => { this.set(7, false, '读不到配置'); this.set(8, false, '读不到配置') }
      })
    } catch (e) { this.set(7, false, '不可用'); this.set(8, false, '不可用') }
  },

  checkChat(cfg) {
    if (!cfg || !cfg.apiKey) { this.set(7, false, '没填密钥'); return }
    this.set(7, false, '请求中…')
    try {
      require('@system.fetch').fetch({
        url: cfg.apiUrl, method: 'POST',
        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + cfg.apiKey },
        data: JSON.stringify({ model: cfg.model, messages: [{ role: 'user', content: 'ping' }], max_tokens: 5 }),
        responseType: 'json',
        success: (res) => {
          let d = res.data
          if (typeof d === 'string') { try { d = JSON.parse(d) } catch (e) {} }
          if (d && d.choices) this.set(7, true, '正常')
          else if (d && d.error) this.set(7, false, String(d.error.message || '').slice(0, 30))
          else this.set(7, false, '响应异常')
        },
        fail: (e, c) => this.set(7, false, '网络错误 ' + c)
      })
    } catch (e) { this.set(7, false, '调用失败') }
  },

  checkTts(cfg) {
    const u = (cfg && cfg.ttsUrl) ? cfg.ttsUrl : 'https://dict.youdao.com/dictvoice?type=2&audio={text}'
    if (u.indexOf('{text}') < 0) { this.set(8, false, '模板缺 {text}'); return }
    this.set(8, false, '请求中…')
    try {
      require('@system.fetch').fetch({
        url: u.replace(/\{text\}/g, encodeURIComponent('测试')),
        method: 'GET', responseType: 'json',
        success: (res) => {
          const n = res.data ? String(res.data).length : 0
          this.set(8, true, '可达 ' + n + ' 字节')
        },
        fail: (e, c) => this.set(8, false, '不可达 ' + c)
      })
    } catch (e) { this.set(8, false, '调用失败') }
  },

  back() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; background-color: #000000; }
.bar { flex-direction: row; align-items: center; justify-content: space-between;
       height: 56px; margin-top: 56px; padding-left: 88px; padding-right: 88px; }
.title { color: #62d0ff; font-size: 26px; font-weight: bold; }
.nav { color: #c9d6e2; font-size: 21px; width: 76px; }
.nav-green { color: #ffffff; background-color: #238636; font-size: 19px;
             width: 80px; height: 44px; line-height: 44px; text-align: center; border-radius: 22px; }

.body { height: 280px; padding-left: 88px; padding-right: 88px; }
.item { flex-direction: row; align-items: center; margin-bottom: 12px; }
.dot-ok { width: 16px; height: 16px; border-radius: 8px; background-color: #3fb950; margin-right: 12px; }
.dot-bad { width: 16px; height: 16px; border-radius: 8px; background-color: #f85149; margin-right: 12px; }
.ib { flex-direction: column; }
.in { color: #e6edf3; font-size: 21px; }
.im { color: #8a94a0; font-size: 16px; }
</style>
