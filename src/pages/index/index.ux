<template>
  <div class="page">
    <div class="bar">
      <text class="persona" @click="cyclePrompt">{{promptName}}</text>
      <text class="bar-btn" @click="goDiag">诊</text>
      <text class="bar-btn" @click="goSettings">设</text>
    </div>

    <scroll class="msgs" scroll-y="true" id="msgScroll">
      <div class="chips" if="{{messages.length === 0}}">
        <text class="chips-title">点一下直接问</text>
        <text class="chip" for="{{quickAsks}}" @click="askQuick($item)">{{$item}}</text>
      </div>

      <div class="msg" for="{{messages}}">
        <div class="{{ $item.role === 'user' ? 'bubble-user' : 'bubble-ai' }}"
             @longpress="readAloud($item)">
          <text class="bubble-text">{{ $item.content }}</text>
        </div>
      </div>

      <div class="msg" if="{{loading}}">
        <div class="bubble-ai"><text class="bubble-text">{{loadingText}}</text></div>
      </div>

      <div class="tip" if="{{hint}}"><text class="tip-text">{{hint}}</text></div>
    </scroll>

    <div class="inputbar">
      <text class="mic {{recording ? 'mic-on' : ''}}" @click="tapMic">{{recording ? '停' : '说'}}</text>
      <input class="inp" type="text" value="{{draft}}" placeholder="输入…" @change="onDraft" />
      <text class="send" @click="send">发</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { loadConfig, saveConfig, getPromptSets, QUICK_ASKS } from '../../common/config.js'
import { askAI, recordVoice, stopVoice, transcribe, speakText, stopSpeak, buzz } from '../../common/api.js'

export default {
  private: {
    messages: [], draft: '', loading: false, sending: false, recording: false,
    loadingText: '思考中', hint: '', promptName: '极简',
    quickAsks: QUICK_ASKS, cfg: null
  },

  onInit() { loadConfig().then((c) => this.applyCfg(c)) },
  onShow() { loadConfig().then((c) => this.applyCfg(c)) },

  applyCfg(c) {
    this.cfg = c
    this.quickAsks = (c.quickAsks && c.quickAsks.length) ? c.quickAsks : QUICK_ASKS
    const sets = getPromptSets()
    const s = sets.filter((x) => x.id === c.promptSetId)[0]
    this.promptName = c.customPrompt ? '自定义' : (s ? s.name : '极简')
    if (!c.apiKey) this.hint = '还没填密钥，点「设」'
  },

  cyclePrompt() {
    const sets = getPromptSets()
    let i = 0
    for (let k = 0; k < sets.length; k++) if (sets[k].id === this.cfg.promptSetId) i = k
    i = (i + 1) % sets.length
    this.cfg.promptSetId = sets[i].id
    this.cfg.customPrompt = ''
    this.promptName = sets[i].name
    this.hint = '已切到「' + sets[i].name + '」'
    buzz(true)
    saveConfig(this.cfg)
  },

  askQuick(q) { this.draft = q; this.send() },

  tapMic() {
    if (this.recording) { stopVoice(); this.recording = false; return }
    if (!this.cfg || !this.cfg.asrKey) { this.hint = '语音识别还没填密钥'; return }
    stopSpeak()
    this.recording = true
    this.hint = '说话…8 秒'
    buzz(true)
    recordVoice(8000).then((uri) => {
      this.recording = false
      this.loading = true
      this.loadingText = '识别中'
      return transcribe(this.cfg, uri)
    }).then((text) => {
      this.loading = false
      this.draft = text
      this.hint = '识别好了，可改完再发'
      buzz(false)
    }).catch((err) => {
      this.recording = false
      this.loading = false
      this.hint = String(err).slice(0, 80)
    })
  },

  readAloud(item) {
    if (!item || item.role !== 'assistant') return
    if (!this.cfg || !this.cfg.ttsUrl) { this.hint = '朗读还没配'; return }
    buzz(true)
    this.hint = '合成中…'
    speakText(this.cfg, item.content)
      .then(() => { this.hint = '播放中' })
      .catch((err) => { this.hint = String(err).slice(0, 80) })
  },

  onDraft(e) { this.draft = e.value },
  goSettings() { router.push({ uri: '/pages/settings' }) },
  goDiag() { router.push({ uri: '/pages/diag' }) },

  send() {
    const text = (this.draft || '').trim()
    if (!text) { this.hint = '先说点什么'; return }
    if (this.sending) return
    if (!this.cfg || !this.cfg.apiKey) { this.hint = '先去「设」填密钥'; return }

    stopSpeak()
    this.hint = ''
    this.sending = true
    this.loading = true
    this.loadingText = '思考中'
    this.messages = this.messages.concat([{ role: 'user', content: text }])
    this.draft = ''

    const history = this.messages.filter((m) => m.role === 'user' || m.role === 'assistant').slice(-6)

    askAI(this.cfg, history).then((reply) => {
      this.messages = this.messages.concat([{ role: 'assistant', content: reply }])
      this.loading = false
      this.sending = false
      buzz(true)
      this.scrollBottom()
    }).catch((err) => {
      this.hint = String(err).slice(0, 90)
      this.loading = false
      this.sending = false
    })
  },

  scrollBottom() {
    try {
      const el = this.$element('msgScroll')
      if (el) el.scrollTo({ top: 999999, behavior: 'smooth' })
    } catch (e) {}
  }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; background-color: #000000; }

/* 顶栏 y 40~100 */
.bar { flex-direction: row; align-items: center; justify-content: center;
       height: 56px; margin-top: 56px; padding-left: 88px; padding-right: 88px; }
.persona { color: #0b0f14; background-color: #62d0ff; font-size: 22px; font-weight: bold;
           padding: 6px 20px; border-radius: 20px; }
.bar-btn { color: #0b0f14; background-color: #30363d; font-size: 22px;
           width: 52px; height: 52px; line-height: 52px; text-align: center;
           border-radius: 26px; margin-left: 10px; }

/* 消息区 y 104~292 */
.msgs { height: 176px; padding-left: 72px; padding-right: 72px; }

.chips { flex-direction: column; padding-top: 2px; }
.chips-title { color: #8a94a0; font-size: 20px; margin-bottom: 8px; text-align: center; }
.chip { background-color: #1c2128; border-radius: 16px; color: #c9d6e2;
        font-size: 20px; padding: 10px 14px; margin-bottom: 8px; text-align: center; }

.msg { flex-direction: column; margin-bottom: 10px; }
.bubble-user { align-self: flex-end; background-color: #1f6feb; border-radius: 16px;
               padding: 10px 14px; max-width: 300px; }
.bubble-ai { align-self: flex-start; background-color: #1c2128; border-radius: 16px;
             padding: 10px 14px; max-width: 320px; }
.bubble-text { color: #e6edf3; font-size: 23px; line-height: 31px; }

.tip { padding: 4px; }
.tip-text { color: #d29922; font-size: 20px; line-height: 26px; }

/* 输入区 y 296~376（关键：必须在这个高度内，否则圆边裁掉） */
.inputbar { flex-direction: row; align-items: center; justify-content: center;
            height: 80px; padding-left: 88px; padding-right: 88px; }
.mic { width: 64px; height: 64px; line-height: 64px; border-radius: 32px;
       background-color: #1c2128; color: #8a94a0; font-size: 22px;
       text-align: center; margin-right: 8px; }
.mic-on { background-color: #b62324; color: #ffffff; }
.inp { flex: 1; height: 64px; background-color: #1c2128; border-radius: 32px;
       color: #e6edf3; font-size: 23px; padding-left: 18px; padding-right: 18px; }
.send { width: 64px; height: 64px; line-height: 64px; margin-left: 8px;
        background-color: #238636; border-radius: 32px;
        color: #ffffff; font-size: 24px; text-align: center; }
</style>
